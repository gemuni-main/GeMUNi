# GeMUNi Environment Configuration
# Copy to .env.local and fill in real values before production deployment.
# Placeholder values allow the app to run in development/mock mode.

# ---- Database (Supabase PostgreSQL) ----
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/gemuni
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-key

# ---- Authentication (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
JWT_SECRET=dev-only-insecure-jwt-secret-change-me

# ---- Research retrieval (Tavily) ----
TAVILY_API_KEY=tvly-placeholder

# ---- LLM providers ----
GEMINI_API_KEY=gemini-placeholder
KIMI_API_KEY=kimi-placeholder
OPENROUTER_API_KEY=openrouter-placeholder

# ---- Embeddings (OpenAI) ----
OPENAI_API_KEY=sk-placeholder
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Inngest ----
INNGEST_EVENT_KEY=placeholder-event-key
INNGEST_SIGNING_KEY=placeholder-signing-key
